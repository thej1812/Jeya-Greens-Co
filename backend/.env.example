# ==========================================
# Coconut Business Website - Backend Environment
# ==========================================

# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/coconut?retryWrites=true&w=majority

# JWT secret key (must be a random string of at least 32 characters)
JWT_SECRET=your_32_char_minimum_random_secret_string_here
JWT_EXPIRES_IN=1d

# Single administrator credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=jeya-greens

# Frontend URL(s) allowed by CORS (comma-separated, no trailing slash)
CLIENT_URL=https://jeya-greens-co.vercel.app,http://localhost:5173

# Max image upload size in MB (defaults to 10)
MAX_IMAGE_SIZE_MB=10

# ==========================================
# Resend HTTPS API (Render-safe email delivery)
# Render Free blocks SMTP ports 25, 465, and 587.
# Resend uses standard HTTPS (port 443).
# ==========================================
# Resend API key starting with 're_' (Get from https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# Verified sender email or default Resend test sender
# Free test mode: "Jeya Greens & Co. <onboarding@resend.dev>"
# Custom verified domain: "Jeya Greens & Co. <contact@yourdomain.com>"
CONTACT_SENDER_EMAIL=Jeya Greens & Co. <onboarding@resend.dev>

# Where customer enquiries should be delivered
# NOTE: In Resend free test mode without a custom domain, this MUST be the email address you signed up to Resend with!
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

CONTACT_TIMEZONE=Asia/Kolkata
CONTACT_RATE_LIMIT_MAX=5
