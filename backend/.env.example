# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:8443,http://localhost:5173

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/coconut?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/coconut?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=jeya_greens

# Upload Configuration
MAX_IMAGE_SIZE_MB=10

# Contact Form & Nodemailer SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
CONTACT_SENDER_EMAIL=your_email@gmail.com
CONTACT_RECEIVER_EMAIL=your_email@gmail.com
CONTACT_TIMEZONE=Asia/Kolkata
CONTACT_RATE_LIMIT_MAX=5
